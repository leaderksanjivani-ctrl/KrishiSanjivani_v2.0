rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // Users collection: Any authenticated user can read profiles, users can write their own profile
    match /users/{userId} {
      allow read: if isAuthenticated();
      allow create, update: if isOwner(userId);
      allow delete: if isOwner(userId);
    }

    // Notifications collection: Authenticated users can read/write their own notifications
    match /notifications/{notificationId} {
      allow read, write: if isAuthenticated();
    }

    // Produce Listings: Anyone can view, authenticated users can create/update
    match /listings/{listingId} {
      allow read: if true;
      allow create, update, delete: if isAuthenticated();
    }

    // Equipment Rental: Anyone can view, authenticated users can rent/list
    match /equipment/{equipmentId} {
      allow read: if true;
      allow create, update, delete: if isAuthenticated();
    }

    // Orders & Bookings: Authenticated users can manage orders/bookings
    match /orders/{orderId} {
      allow read, write: if isAuthenticated();
    }

    match /bookings/{bookingId} {
      allow read, write: if isAuthenticated();
    }

    // Public read-only reference data (Schemes, Rights, Price History, FAQs, FPOs)
    match /schemes/{schemeId} {
      allow read: if true;
      allow write: if isAuthenticated();
    }

    match /rightsActs/{actId} {
      allow read: if true;
      allow write: if isAuthenticated();
    }

    match /priceHistory/{priceId} {
      allow read: if true;
      allow write: if isAuthenticated();
    }

    match /chatbotFaq/{faqId} {
      allow read: if true;
      allow write: if isAuthenticated();
    }

    match /fpos/{fpoId} {
      allow read: if true;
      allow write: if isAuthenticated();
    }

    // Default fallback rule for development
    match /{document=**} {
      allow read, write: if isAuthenticated();
    }
  }
}
