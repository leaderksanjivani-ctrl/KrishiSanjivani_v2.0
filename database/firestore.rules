rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function owner(uid) { return signedIn() && request.auth.uid == uid; }
    function admin() { return signedIn() && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin'; }

    match /users/{uid} {
      allow read: if owner(uid) || admin();
      allow create: if owner(uid) && request.resource.data.role in ['farmer', 'buyer', 'bulk_buyer'];
      allow update: if admin() || (owner(uid) && request.resource.data.role == resource.data.role && request.resource.data.uid == resource.data.uid);
      allow delete: if admin();
    }
    match /notifications/{id} {
      allow read, update: if admin() || owner(resource.data.userId);
      allow create: if signedIn() && (admin() || owner(request.resource.data.userId));
      allow delete: if admin() || owner(resource.data.userId);
    }
    match /listings/{id} {
      allow read: if true;
      allow create: if signedIn() && owner(request.resource.data.farmerId);
      allow update, delete: if admin() || owner(resource.data.farmerId);
    }
    match /orders/{id} {
      allow read: if signedIn() && (admin() || owner(resource.data.buyerId) || owner(resource.data.farmerId));
      allow create: if signedIn() && owner(request.resource.data.buyerId);
      allow update: if admin() || owner(resource.data.buyerId) || owner(resource.data.farmerId);
      allow delete: if admin();
    }
    match /equipment/{id} {
      allow read: if true;
      allow create: if signedIn() && owner(request.resource.data.ownerId);
      allow update, delete: if admin() || owner(resource.data.ownerId);
    }
    match /bookings/{id} {
      allow read: if admin() || owner(resource.data.userId) || owner(resource.data.ownerId);
      allow create: if signedIn() && owner(request.resource.data.userId);
      allow update: if admin() || owner(resource.data.userId) || owner(resource.data.ownerId);
      allow delete: if admin();
    }
    match /complaints/{id} {
      allow read: if admin() || owner(resource.data.userId);
      allow create: if signedIn() && owner(request.resource.data.userId);
      allow update: if admin() || owner(resource.data.userId);
      allow delete: if admin();
    }
    match /schemes/{id} { allow read: if true; allow write: if admin(); }
    match /rightsActs/{id} { allow read: if true; allow write: if admin(); }
    match /priceHistory/{id} { allow read: if true; allow write: if admin(); }
    match /chatbotFaq/{id} { allow read: if true; allow write: if admin(); }
    match /fpos/{id} { allow read: if true; allow write: if admin() || owner(request.resource.data.ownerId); }
    match /auctions/{id} {
      allow read: if true;
      allow create: if signedIn() && owner(request.resource.data.farmerId);
      allow update: if admin() || owner(resource.data.farmerId);
      match /bids/{bidId} {
        allow read: if signedIn();
        allow create: if signedIn() && owner(request.resource.data.bidderId) && request.resource.data.amount is number;
        allow update, delete: if admin();
      }
    }
    match /groupBuys/{id} {
      allow read: if true;
      allow create: if signedIn() && owner(request.resource.data.createdBy);
      allow update: if admin() || owner(resource.data.createdBy) || owner(request.resource.data.participantIds[request.auth.uid]);
      match /participants/{participantId} {
        allow read: if signedIn();
        allow create, update: if signedIn() && owner(participantId);
        allow delete: if admin() || owner(participantId);
      }
    }
    match /expertQueries/{id} {
      allow read: if admin() || owner(resource.data.farmerId);
      allow create: if signedIn() && owner(request.resource.data.farmerId);
      allow update: if admin() || owner(resource.data.farmerId);
    }
    match /verifiedInputs/{id} { allow read: if true; allow write: if admin(); }
    match /facilities/{id} { allow read: if true; allow write: if admin(); }
    match /auditLog/{id} { allow read: if admin(); allow create: if signedIn() && (admin() || request.resource.data.actorId == request.auth.uid); allow update, delete: if false; }
    match /ledgerChain/{id} { allow read: if signedIn(); allow create: if admin() || signedIn(); allow update, delete: if false; }
    match /admin/{document=**} { allow read, write: if admin(); }
    match /{document=**} { allow read, write: if false; }
  }
}
